{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FindLyrics",
  "version": "0.1.0",
  "identifier": "com.findlyrics.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FindLyrics 🎵 Lyrics Finder & Embedder",
        "width": 1100,
        "height": 780,
        "minWidth": 850,
        "minHeight": 620,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "dialog": null
  }
}
